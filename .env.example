# Google Cloud OAuth client of type "TVs and Limited Input devices".
# Create one at https://console.cloud.google.com/apis/credentials
# and enable the Google Photos Ambient API for the project.
#
# Copy this file to .env and fill in your values. .env is gitignored.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Port for the local helper process (optional, default 4000)
# PORT=4000

# Name shown for this frame in the Google Photos app (optional)
# AMBIENT_DEVICE_NAME=Living Room TV
