{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gpicshow-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "gpicshow-helper",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "helper"],
      "port": 4000,
      "autoPort": false
    },
    {
      "name": "gpicshow-pages-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--base", "/gpicshow/", "--port", "4173", "--strictPort"],
      "port": 4173,
      "url": "http://localhost:4173"
    }
  ]
}
